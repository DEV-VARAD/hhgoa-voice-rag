{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/query",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/transcribe",
      "dest": "/api/transcribe/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}